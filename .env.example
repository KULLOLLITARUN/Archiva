# Archiva Environment Configuration
# Copy this file to .env and fill in your actual values.

# ── Required ──────────────────────────────────────────────────────────────────

# Get your Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Postgres connection string (db/postgres.py) — document/chunk/feedback
# persistence. Use a dedicated role/database, not the postgres superuser.
# The app starts without this (falls back to an empty in-memory store) but
# /upload and anything that touches documents needs it to actually work.
# See db/schema.sql for why there's no pgvector/ANN index on the embedding
# column yet.
DATABASE_URL=postgresql://archiva:your_password_here@localhost:5432/archiva

# ── Optional ──────────────────────────────────────────────────────────────────

# Several keys, comma-separated, are rotated round-robin (llm/groq_manager.py).
# GROQ_API_KEYS=key_one,key_two

# Models (defaults shown). Groq retires models from time to time; if requests
# fail with model_not_found, pick current ones from
# https://console.groq.com/docs/models
# GROQ_FAST=openai/gpt-oss-20b
# GROQ_STRONG=openai/gpt-oss-120b
# GROQ_QWEN=qwen/qwen3.8-27b

# ── Retrieval ─────────────────────────────────────────────────────────────────

# Hybrid search: BM25 keyword scores fused with local sentence-transformer
# embeddings (no embedding API needed).

# Minimum BM25 score for a chunk to be returned (BM25 is unbounded, not 0-1).
# 0.1 = permissive (returns any keyword match)
# 0.5-1.0 = stricter (requires stronger overlap)
BM25_THRESHOLD=0.1
TOP_K=5
FINAL_K=5

# ── Storage ───────────────────────────────────────────────────────────────────

MAX_TOTAL_CHUNKS=5000
MAX_CHUNKS_PER_FILE=500

# ── Session Memory (Fix #16) ──────────────────────────────────────────────────

# When true (default), chat history is stored in Postgres (chat_sessions) and
# survives restarts. Set to false to keep it in process memory only.
PERSIST_MEMORY=true

# ── Reflection Loop (Fix #21) ─────────────────────────────────────────────────

# Maximum retrieve→generate→reflect cycles per query (hard cap).
# Higher = better quality but more Groq API calls and latency.
# Default: 3 (recommended; 1 disables the loop entirely)
MAX_REFLECTION_ATTEMPTS=3

# Minimum confidence score (0.0–1.0) to accept an answer without retrying.
# Below this, the loop will retry if attempts remain.
# Default: 0.4
MIN_REFLECTION_CONFIDENCE=0.4

# Minimum word-overlap ratio between answer and retrieved chunks.
# Below this, reflection triggers a retry_search decision.
# Default: 0.15 (15% of answer words must appear in source chunks)
MIN_OVERLAP_RATIO=0.15

# ── OCR for scanned PDFs ──────────────────────────────────────────────────────

# Scanned PDFs are OCR'd in a background job (needs rapidocr-onnxruntime and
# pypdfium2, both in requirements.txt). Set to false to reject scans instead.
OCR_ENABLED=true
# Pages OCR'd per file; later pages are skipped.
OCR_MAX_PAGES=50
# OCR lines below this confidence (0-1) are dropped rather than indexed.
OCR_MIN_LINE_CONFIDENCE=0.6

# ── Multiple worker processes ─────────────────────────────────────────────────

# Seconds between each worker's check for document changes made by others.
STORE_SYNC_INTERVAL_S=2
# Rate-limit counters. Default is per-process; with --workers N the effective
# limit is N x the stated one. Use Redis for a single shared limit
# (pip install redis), e.g. redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://
